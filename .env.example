# Copie para .env e preencha o que for usar. Nada aqui é obrigatório para buscar.

# Senha para entrar no site (deixe vazio para uso local sem senha).
APP_PASSWORD=

# Lojas consultadas (vazio = todas). Opções:
# mercadolivre,amazon,magalu,casasbahia,americanas,carrefour,kabum,aliexpress,buscape
SOURCES=

# Alertas por e-mail (Gmail: use uma "senha de app" em Conta Google > Segurança > Senhas de app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Verificação automática dos alertas, em minutos, enquanto o servidor estiver aberto (0 desliga).
ALERTS_INTERVAL_MIN=60
# Segredo para a rota /api/cron/check-alerts (usada na Vercel).
CRON_SECRET=
# Endereço do site, usado nos links dos e-mails.
APP_URL=http://localhost:3000

# Navegador escondido (Mercado Livre, Magalu, Casas Bahia)
# BROWSER_VISIBLE=1 mostra a janela do Chrome (útil se um site pedir verificação).
BROWSER_VISIBLE=
# BROWSER_HEADLESS=1 força modo headless (os sites costumam bloquear).
BROWSER_HEADLESS=

# Shopee: API de afiliados (affiliate.shopee.com.br > Open API). Sem isso a Shopee fica desligada.
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# API oficial do Mercado Livre (opcional, etapa 2): https://developers.mercadolivre.com.br/
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:3000/api/auth/mercadolivre/callback
# Links de afiliado do Mercado Livre (etapa 2)
ML_AFFILIATE_MATT_WORD=
ML_AFFILIATE_MATT_TOOL=

# LLM na nuvem (Ollama Cloud), reservado para a etapa de relevância assistida por IA.
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com

# Banco em produção (Vercel + Turso). Local usa SQLite (achei.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
